<?xml version="1.0" ?>
<!--
  MARS warehouse world (Gazebo Harmonic, ROS2 Jazzy)
  Arena: 8 m x 8 m, centred on the origin. +x = right, +y = up (as in the sketch).

  Rover poses (x, y, yaw):
    Start / Stop / Drop : ( 3.0, -3.0, 3.14159)   facing west
    Aisle 1 stop        : (-2.2,  2.5, 3.14159)   facing the shelf
    Aisle 2 stop        : (-2.2,  0.0, 3.14159)
    Aisle 3 stop        : (-2.2, -2.5, 3.14159)

  Aisle -> QR:  Aisle 1 = APPLE001, Aisle 2 = BANANA001, Aisle 3 = GRAPES001
  Textures are loaded relative to this file (textures/).
-->
<sdf version="1.9">
  <world name="mars_warehouse">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1.0</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena walls: inner faces at x = +/-4, y = +/-4, height 0.6 m -->
    <model name="arena_walls">
      <static>true</static>
      <link name="north">
        <pose>0 4.05 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>8.2 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="south">
        <pose>0 -4.05 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>8.2 0.1 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="east">
        <pose>4.05 0 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 8.0 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.0 0.6</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="west">
        <pose>-4.05 0 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 8.0 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.0 0.6</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ AISLE 1 (top) : APPLE001 ============ -->
    <model name="aisle_1">
      <static>true</static>
      <pose>-3.0 2.5 0 0 0 0</pose>
      <link name="link">
        <!-- Shelf block: 0.5 (x) x 1.6 (y) x 0.6 (z) -->
        <collision name="shelf_collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.5 1.6 0.6</size></box></geometry>
        </collision>
        <visual name="shelf_visual">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.5 1.6 0.6</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
        <!-- QR placard on the east face -->
        <visual name="qr_placard">
          <pose>0.256 0 0.3 0 0 0</pose>
          <geometry><box><size>0.012 0.25 0.25</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>textures/qr_APPLE001.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
        <!-- Rover stop zone marker (visual only) -->
        <visual name="stop_zone">
          <pose>0.8 0 0.002 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.004</size></box></geometry>
          <material>
            <ambient>0.1 0.8 0.2 1</ambient>
            <diffuse>0.1 0.8 0.2 1</diffuse>
            <transparency>0.5</transparency>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ AISLE 2 (middle) : BANANA001 ============ -->
    <model name="aisle_2">
      <static>true</static>
      <pose>-3.0 0.0 0 0 0 0</pose>
      <link name="link">
        <collision name="shelf_collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.5 1.6 0.6</size></box></geometry>
        </collision>
        <visual name="shelf_visual">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.5 1.6 0.6</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
        <visual name="qr_placard">
          <pose>0.256 0 0.3 0 0 0</pose>
          <geometry><box><size>0.012 0.25 0.25</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>textures/qr_BANANA001.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
        <visual name="stop_zone">
          <pose>0.8 0 0.002 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.004</size></box></geometry>
          <material>
            <ambient>0.1 0.8 0.2 1</ambient>
            <diffuse>0.1 0.8 0.2 1</diffuse>
            <transparency>0.5</transparency>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ AISLE 3 (bottom) : GRAPES001 ============ -->
    <model name="aisle_3">
      <static>true</static>
      <pose>-3.0 -2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="shelf_collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.5 1.6 0.6</size></box></geometry>
        </collision>
        <visual name="shelf_visual">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.5 1.6 0.6</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
        <visual name="qr_placard">
          <pose>0.256 0 0.3 0 0 0</pose>
          <geometry><box><size>0.012 0.25 0.25</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>textures/qr_GRAPES001.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
        <visual name="stop_zone">
          <pose>0.8 0 0.002 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.004</size></box></geometry>
          <material>
            <ambient>0.1 0.8 0.2 1</ambient>
            <diffuse>0.1 0.8 0.2 1</diffuse>
            <transparency>0.5</transparency>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ ROVER START / STOP / DROP ZONE (bottom-right) ============ -->
    <model name="start_stop_zone">
      <static>true</static>
      <pose>3.0 -3.0 0 0 0 0</pose>
      <link name="link">
        <visual name="zone">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><box><size>1.6 1.6 0.004</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.9 1</ambient>
            <diffuse>0.2 0.4 0.9 1</diffuse>
            <transparency>0.4</transparency>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>






