<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- gripper_link: was referenced as a parent link in the uploaded archive but never
       defined there. Added here with the matching part meshes/inertials so the chain
       from wrist_link -> gripper_link -> moving_jaw is complete. -->
  <xacro:macro name="so101_gripper_link"
               params="prefix:='' mesh_dir:='package://mars/description/arm/meshes' add_transmission:='false'">

    <link name="${prefix}gripper_link">
      <xacro:inertial_block
        xyz="0.000213627 0.000245138 -0.025187" rpy="0 0 0"
        mass="0.087"
        ixx="2.75087e-05" ixy="-3.35241e-07" ixz="-5.7352e-06"
        iyy="4.33657e-05" iyz="-5.17847e-08" izz="3.45059e-05"/>

      <xacro:mesh_vc filename="${mesh_dir}/sts3215_03a_v1.stl"
        xyz="0.0077 0.0001 -0.0234" rpy="-1.5708 -5.19179e-17 -1.66533e-16" material="sts3215"/>
      <xacro:mesh_vc filename="${mesh_dir}/wrist_roll_follower_so101_v1.stl"
        xyz="8.32667e-17 -0.000218214 0.000949706" rpy="-3.14159 -5.55112e-17 0" material="3d_printed"/>
    </link>

    <!-- moving_jaw_link -->
    <link name="${prefix}moving_jaw_link">
      <xacro:inertial_block
        xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0"
        mass="0.012"
        ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09"
        iyy="1.89032e-06" iyz="-1.09945e-07" izz="5.28738e-06"/>

      <xacro:mesh_vc filename="${mesh_dir}/moving_jaw_so101_v1.stl"
        xyz="-5.55112e-17 -5.55112e-17 0.0189" rpy="9.53145e-17 6.93889e-18 1.24077e-24" material="3d_printed"/>
    </link>

    <!-- gripper: the jaw open/close joint -->
    <joint name="${prefix}gripper" type="revolute">
      <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-08 -1.41553e-15"/>
      <parent link="${prefix}gripper_link"/>
      <child link="${prefix}moving_jaw_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
    </joint>

    <xacro:if value="${add_transmission}">
      <xacro:simple_transmission
        name="${prefix}gripper_trans"
        joint="${prefix}gripper"
        actuator="${prefix}motor6"/>
    </xacro:if>
  </xacro:macro>

  <!-- Shared: gripper_frame dummy link -->
  <xacro:macro name="so101_gripper_frame" params="prefix:=''">
    <link name="${prefix}gripper_frame_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-9"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_frame_joint" type="fixed">
      <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0"/>
      <parent link="${prefix}gripper_link"/>
      <child link="${prefix}gripper_frame_link"/>
    </joint>
  </xacro:macro>

  <!-- Shared: wrist_roll joint (+ optional transmission) -->
  <xacro:macro name="so101_wrist_roll_joint"
               params="prefix:='' add_transmission:='false'">
    <joint name="${prefix}wrist_roll" type="revolute">
      <origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
      <parent link="${prefix}wrist_link"/>
      <child link="${prefix}gripper_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121"/>
    </joint>

    <xacro:if value="${add_transmission}">
      <xacro:simple_transmission
        name="${prefix}wrist_roll_trans"
        joint="${prefix}wrist_roll"
        actuator="${prefix}motor5"/>
    </xacro:if>
  </xacro:macro>

</robot>
