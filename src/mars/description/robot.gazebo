<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Caster wheel friction parameters -->
    <gazebo reference="caster_link">
        <mu1>0.000002</mu1>
        <mu2>0.000002</mu2>
    </gazebo>

    <gazebo reference="wheel1_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="wheel2_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <!-- Plugins -->
    <gazebo>
        <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
            <left_joint>wheel1_joint</left_joint>
            <right_joint>wheel2_joint</right_joint>
            <wheel_separation>0.445</wheel_separation>
            <wheel_radius>0.076</wheel_radius>
            <max_linear_acceleration>5</max_linear_acceleration>
            <topic>cmd_vel</topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_topic>odom</odom_topic>
            <odom_publisher_frequency>30</odom_publisher_frequency>
            <tf_topic>/tf</tf_topic>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>wheel1_joint</joint_name>
            <joint_name>wheel2_joint</joint_name>
            <joint_name>arm_shoulder_pan</joint_name>
            <joint_name>arm_shoulder_lift</joint_name>
            <joint_name>arm_elbow_flex</joint_name>
            <joint_name>arm_wrist_flex</joint_name>
            <joint_name>arm_wrist_roll</joint_name>
            <joint_name>arm_gripper</joint_name>
        </plugin>
    </gazebo>

    <!-- Arm joints have no actuation yet (add_transmissions=false), so with no
         controller they free-fall under gravity - that's the "hanging last link".
         These hold each joint at its commanded position (default 0) until you
         wire up real control; command topics are gz.msgs.Double on
         /model/differential_drive_robot/joint/<joint_name>/cmd_pos -->
    <xacro:macro name="hold_joint" params="joint p_gain:=100 d_gain:=2">
        <gazebo>
            <plugin filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
                <joint_name>${joint}</joint_name>
                <p_gain>${p_gain}</p_gain>
                <i_gain>0.0</i_gain>
                <d_gain>${d_gain}</d_gain>
                <i_max>1</i_max>
                <i_min>-1</i_min>
                <cmd_max>10</cmd_max>
                <cmd_min>-10</cmd_min>
            </plugin>
        </gazebo>
    </xacro:macro>

    <xacro:hold_joint joint="arm_shoulder_pan"/>
    <xacro:hold_joint joint="arm_shoulder_lift"/>
    <xacro:hold_joint joint="arm_elbow_flex"/>
    <xacro:hold_joint joint="arm_wrist_flex"/>
    <xacro:hold_joint joint="arm_wrist_roll"/>
    <xacro:hold_joint joint="arm_gripper" p_gain="20" d_gain="0.5"/>

    <!-- Lidar Sensor -->
    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <gz_frame_id>lidar_link</gz_frame_id>
            <frame_id>lidar_link</frame_id>
            <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159265</min_angle>
                        <max_angle>3.14159265</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <always_on>true</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

</robot>